# Django
SECRET_KEY=django-insecure-change-me-in-production-please-rotate-this-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL (used by default)
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Set to True to use local sqlite3 instead of PostgreSQL (handy if Postgres is not running yet)
USE_SQLITE=False
